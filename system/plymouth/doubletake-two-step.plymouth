[Plymouth Theme]
Name=DoubleTake
Description=The DoubleTake logo while the tablet starts (still: for systems without the script plugin)
ModuleName=two-step

[two-step]
ImageDir=/usr/share/plymouth/themes/doubletake
HorizontalAlignment=.5
VerticalAlignment=.82
WatermarkHorizontalAlignment=.5
WatermarkVerticalAlignment=.45
Transition=none
TransitionDuration=0.0
BackgroundStartColor=0x0a0e12
BackgroundEndColor=0x0a0e12
